{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommitsDisabled"],
  "schedule": ["before 6am on monday"],
  "timezone": "Asia/Jerusalem",
  "minimumReleaseAge": "3 days",
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "Group routine non-major updates into one weekly PR",
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "non-major dependencies"
    },
    {
      "description": "Keep Docker base images and the Node version in step",
      "matchDatasources": ["docker", "node-version"],
      "groupName": "runtime images"
    }
  ]
}
